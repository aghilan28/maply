# Mapbox public access token (pk.eyJ...)
# Required for vector satellite tiles, 3D terrain, and Mapbox Geocoding API.
# Register at https://account.mapbox.com
VITE_MAPBOX_TOKEN=

# (Optional) Google Places Platform API Key
# Enables Google Places (New) API for business details, reviews, and photos.
# Obtain from https://console.cloud.google.com
VITE_GOOGLE_PLACES_API_KEY=

# (Optional) Foursquare Places API service token for venue photography & visual enrichment.
VITE_FOURSQUARE_API_KEY=
FOURSQUARE_API_KEY=

# (Optional) Gemini AI API Key
GEMINI_API_KEY=
